{
	"name": "@mivia-desktop/ui",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"build:e2e": "vite build --mode e2e",
		"typecheck": "tsc -p tsconfig.json && tsc -p e2e/tsconfig.json",
		"test": "vitest run",
		"fallow": "fallow",
		"size": "vite build && node scripts/startup-bundle.mjs && size-limit",
		"i18n:check": "node scripts/i18n-check.mjs",
		"perf:preview": "node scripts/perf-preview.mjs",
		"playwright": "playwright test --project smoke",
		"e2e": "playwright test --project e2e"
	},
	"dependencies": {
		"@mantine/core": "9.3.1",
		"@mantine/hooks": "9.3.1",
		"@mantine/notifications": "9.3.1",
		"@mivia-ai/theme": "workspace:*",
		"@tabler/icons-react": "3.44.0",
		"@tanstack/react-query": "5.104.1",
		"@tanstack/react-router": "1.170.41",
		"@tauri-apps/api": "2.12.1",
		"i18next": "26.4.2",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"react-i18next": "17.0.15"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.13.0",
		"@playwright/test": "1.63.0",
		"@size-limit/file": "14.1.0",
		"@testing-library/react": "16.3.3",
		"@types/node": "24.19.1",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.7",
		"@vitejs/plugin-react": "6.1.1",
		"fallow": "3.31.0",
		"jsdom": "30.1.1",
		"size-limit": "14.1.0",
		"typescript": "6.0.3",
		"vite": "8.3.1",
		"vitest": "5.0.3"
	}
}

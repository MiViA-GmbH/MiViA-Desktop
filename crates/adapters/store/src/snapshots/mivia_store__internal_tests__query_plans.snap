  LIST SUBQUERY 1
  SCAN json_each VIRTUAL TABLE INDEX 1:
  CREATE BLOOM FILTER
  SCALAR SUBQUERY 2
  SEARCH h USING PRIMARY KEY (account_id=?)
claim recovery attempts:

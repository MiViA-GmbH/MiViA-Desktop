{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "MiViA Desktop",
	"version": "../package.json",
	"identifier": "ai.mivia.desktop",
	"app": {
		"withGlobalTauri": false,
		"windows": [
			{
				"label": "main",
				"title": "MiViA Desktop",
				"create": false,
				"visible": false,
				"width": 1100,
				"height": 720,
				"minWidth": 760,
				"minHeight": 480,
				"center": true
			}
		],
		"security": {
			"freezePrototype": true,
			"csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'",
			"capabilities": ["main"]
		}
	},
	"bundle": {
		"active": false,
		"createUpdaterArtifacts": false,
		"icon": ["icons/icon.ico"]
	},
	"plugins": {
		"updater": {
			"pubkey": "",
			"requireSignedVersion": true,
			"windows": {
				"installMode": "quiet"
			}
		}
	},
	"build": {
		"frontendDist": "../ui/dist",
		"devUrl": "http://localhost:5173"
	}
}

{
	"$schema": "../gen/schemas/desktop-schema.json",
	"identifier": "main",
	"description": "The main window: app commands and event listening only.",
	"windows": ["main"],
	"local": true,
	"permissions": [
		"core:event:allow-listen",
		"core:event:allow-unlisten",
		"allow-get-locale",
		"allow-get-account",
		"allow-list-folders",
		"allow-list-holds",
		"allow-list-needs-attention",
		"allow-list-history",
		"allow-get-batch",
		"allow-list-batch-items",
		"allow-list-series-reports",
		"allow-get-one-off",
		"allow-get-remaining-uploads",
		"allow-ui-ready",
		"allow-set-language",
		"allow-finish-series",
		"allow-pause-folder",
		"allow-resume-folder",
		"allow-clear-series-attention",
		"allow-try-again-report-part",
		"allow-check-connection-now",
		"allow-open-target",
		"allow-get-setup",
		"allow-get-catalogue",
		"allow-get-integration",
		"allow-save-setup",
		"allow-pick-setup-folder",
		"allow-connect-access-key",
		"allow-import-legacy-key",
		"allow-close-legacy-app",
		"allow-complete-setup",
		"allow-quit-app",
		"allow-pick-folder",
		"allow-add-folder",
		"allow-switch-account",
		"allow-sign-out",
		"allow-set-integration",
		"allow-confirm-one-off",
		"allow-discard-one-off",
		"allow-add-images"
	]

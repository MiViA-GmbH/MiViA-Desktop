{
	"$schema": "../gen/schemas/desktop-schema.json",
	"identifier": "main",
	"description": "The main window: app commands and event listening only.",
	"windows": ["main"],
	"local": true,
	"permissions": [
		"core:event:allow-listen",
		"core:event:allow-unlisten",
		"allow-get-locale",
		"allow-get-account",
		"allow-list-folders",
		"allow-list-holds",
		"allow-list-needs-attention",
		"allow-list-history",
		"allow-get-batch",
		"allow-list-batch-items",
		"allow-list-series-reports",
		"allow-ui-ready",
		"allow-set-language",
		"allow-finish-series",
		"allow-pause-folder",
		"allow-resume-folder",
		"allow-clear-series-attention",
		"allow-try-again-report-part",
		"allow-check-connection-now",
		"allow-open-target"
	]
}
